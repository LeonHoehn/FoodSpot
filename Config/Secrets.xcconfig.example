// Kopieren nach Secrets.xcconfig und mit echten Werten aus dem
// Supabase-Dashboard (Project Settings -> API) füllen.
//
// Wichtig: "//" wird in .xcconfig-Dateien als Kommentar interpretiert.
// Der leere Makro-Ausdruck $() trennt die Slashes, ohne den Wert zu ändern.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = your-anon-key
